// Timbre Script-Schnittstelle – v0.6 (3D: Position/Drehung/Skala, Körper)
//
// Beschreibung der Funktionen, die Scripts in jeder Sprache bekommen.
// Technisch sind die Gäste derzeit einfache WebAssembly-Core-Module mit schmaler
// C-Schnittstelle (siehe docs/scripting-abi.md) – diese Datei ist die sprachneutrale
// Beschreibung derselben Funktionen.
package timbre:engine@0.6.0;

interface host {
    /// Daten, die eine Nachricht zwischen Sprachen tragen kann.
    variant simple-value {
        none,
        boolean(bool),
        number(f64),
        integer(s64),
        text(string),
    }

    /// Ausgabe in die Konsole.
    log: func(message: string);
    /// Sekunden seit ▶.
    time: func() -> f64;

    /// Objekte (IDs sind 64-Bit-Zahlen).
    spawn: func(name: string) -> u64;
    find: func(name: string) -> option<u64>;
    /// Löscht auch alle Kinder.
    destroy: func(entity: u64);
    /// Baum im Explorer: none = oberste Ebene.
    set-parent: func(entity: u64, parent: option<u64>);
    get-parent: func(entity: u64) -> option<u64>;

    set-position: func(entity: u64, x: f32, y: f32);
    get-position: func(entity: u64) -> option<tuple<f32, f32>>;
    set-rotation: func(entity: u64, radians: f32);
    get-rotation: func(entity: u64) -> f32;
    set-scale: func(entity: u64, x: f32, y: f32);
    set-velocity: func(entity: u64, vx: f32, vy: f32, spin: f32);
    /// false, wenn es die Textur nicht gibt.
    set-sprite: func(entity: u64, texture: string, width: f32, height: f32, layer: s32) -> bool;
    set-color: func(entity: u64, r: f32, g: f32, b: f32, a: f32);

    /// 3D: Position in Weltkoordinaten, Drehung in Grad (X, Y, Z) und Skala relativ zum Eltern-Objekt.
    set-position3d: func(entity: u64, x: f32, y: f32, z: f32);
    get-position3d: func(entity: u64) -> option<tuple<f32, f32, f32>>;
    set-rotation3d: func(entity: u64, x: f32, y: f32, z: f32);
    get-rotation3d: func(entity: u64) -> option<tuple<f32, f32, f32>>;
    set-scale3d: func(entity: u64, x: f32, y: f32, z: f32);
    get-scale3d: func(entity: u64) -> option<tuple<f32, f32, f32>>;
    enum mesh-shape { cube, sphere, plane, cylinder }
    /// none = Körper entfernen
    set-mesh: func(entity: u64, shape: option<mesh-shape>, r: f32, g: f32, b: f32);

    /// Eingabe
    key-down: func(key: string) -> bool;
    key-pressed: func(key: string) -> bool;
    mouse-position: func() -> tuple<f32, f32>;

    /// Kamera
    set-camera: func(x: f32, y: f32, zoom: f32);

    get-name: func(entity: u64) -> option<string>;

    /// Kollisionen
    enum shape { circle, box }
    set-collision: func(entity: u64, shape: option<shape>, solid: bool, anchored: bool);
    get-touching: func(entity: u64) -> list<u64>;

    /// Nachricht an alle Scripts (→ on-message)
    broadcast: func(message: string, data: option<string>);

    /// Maus (0 links, 1 rechts, 2 Mitte)
    mouse-down: func(button: u8) -> bool;
    mouse-pressed: func(button: u8) -> bool;

    /// Text über dem Spiel
    ui-text: func(key: string, text: string, x: f32, y: f32, size: f32, r: f32, g: f32, b: f32, a: f32);
    ui-clear: func(key: option<string>);

    /// Sound aus dem Ordner `sounds/` abspielen (Name ohne Endung). false = unbekannter Sound.
    play-sound: func(name: string, volume: f32, looped: bool) -> bool;
    /// Nachricht an alle Scripts (auch anderer Sprachen). Über Sprachgrenzen nur einfache Daten.
    broadcast: func(message: string, data: simple-value);

    /// Laufende Sounds stoppen – ohne Name: alle.
    stop-sounds: func(name: option<string>);
}

/// Ein Script: bekommt Engine-Funktionen, liefert Lebenszyklus-Callbacks.
world script {
    import host;

    /// Jedes Script kennt sein eigenes Objekt und dessen Eltern (in Luau: script.id, script.parent).
    /// Der Host übergibt beides beim Laden.

    /// Einmal nach dem Laden aller Scripts (▶).
    export on-start: func();

    /// 60-mal pro Sekunde, dt = Sekunden seit dem letzten Aufruf.
    export on-update: func(dt: f32);

    /// Das Eltern-Objekt des Scripts hat ein anderes Objekt berührt.
    export on-touch: func(other: u64);

    /// Nachricht von timbre.broadcast.
    export on-message: func(message: string, data: simple-value);

    // Dazu in jeder Sprache: task.wait / task.delay / task.spawn und eine gemeinsame Tabelle `shared`.
}
