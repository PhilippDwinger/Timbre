// Timbre Script-Schnittstelle – v0.3 (Meilenstein 5: Scripts als Objekte)
//
// Beschreibung der Funktionen, die Scripts in jeder Sprache bekommen.
// Technisch sind die Gäste derzeit einfache WebAssembly-Core-Module mit schmaler
// C-Schnittstelle (siehe docs/scripting-abi.md) – diese Datei ist die sprachneutrale
// Beschreibung derselben Funktionen.
package timbre:engine@0.3.0;

interface host {
    /// Ausgabe in die Konsole.
    log: func(message: string);
    /// Sekunden seit ▶.
    time: func() -> f64;

    /// Objekte (IDs sind 64-Bit-Zahlen).
    spawn: func(name: string) -> u64;
    find: func(name: string) -> option<u64>;
    /// Löscht auch alle Kinder.
    destroy: func(entity: u64);
    /// Baum im Explorer: none = oberste Ebene.
    set-parent: func(entity: u64, parent: option<u64>);
    get-parent: func(entity: u64) -> option<u64>;

    set-position: func(entity: u64, x: f32, y: f32);
    get-position: func(entity: u64) -> option<tuple<f32, f32>>;
    set-rotation: func(entity: u64, radians: f32);
    get-rotation: func(entity: u64) -> f32;
    set-scale: func(entity: u64, x: f32, y: f32);
    set-velocity: func(entity: u64, vx: f32, vy: f32, spin: f32);
    /// false, wenn es die Textur nicht gibt.
    set-sprite: func(entity: u64, texture: string, width: f32, height: f32, layer: s32) -> bool;
    set-color: func(entity: u64, r: f32, g: f32, b: f32, a: f32);

    /// Eingabe
    key-down: func(key: string) -> bool;
    key-pressed: func(key: string) -> bool;
    mouse-position: func() -> tuple<f32, f32>;

    /// Kamera
    set-camera: func(x: f32, y: f32, zoom: f32);
}

/// Ein Script: bekommt Engine-Funktionen, liefert Lebenszyklus-Callbacks.
world script {
    import host;

    /// Jedes Script kennt sein eigenes Objekt und dessen Eltern (in Luau: script.id, script.parent).
    /// Der Host übergibt beides beim Laden.

    /// Einmal nach dem Laden aller Scripts (▶).
    export on-start: func();

    /// 60-mal pro Sekunde, dt = Sekunden seit dem letzten Aufruf.
    export on-update: func(dt: f32);
}
